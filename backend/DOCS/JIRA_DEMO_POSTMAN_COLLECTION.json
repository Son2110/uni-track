{
  "info": {
    "name": "PMSS Jira Integration Demo",
    "description": "Demo collection for Jira Integration feature in PMSS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7183",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "e305ac16-c8dd-41fd-60cd-08de5e853de4",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Scene 1: Admin Setup",
      "item": [
        {
          "name": "1.1 Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.token);",
                  "    console.log('Admin token saved!');",
                  "}",
                  "",
                  "pm.test('Login successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.token).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@pmss.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login as Admin to get JWT token"
          }
        },
        {
          "name": "1.2 Create JiraConfig",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('JiraConfig created', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Has masked token', function() {",
                  "    pm.expect(jsonData.apiTokenMasked).to.include('****');",
                  "});",
                  "",
                  "pm.test('Has createdByUserId', function() {",
                  "    pm.expect(jsonData.createdByUserId).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"jiraUrl\": \"https://beu2901.atlassian.net\",\n  \"apiToken\": \"YOUR_JIRA_API_TOKEN_HERE\",\n  \"projectKey\": \"SP\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jira/config",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jira", "config"]
            },
            "description": "Admin creates JiraConfig with shared API token"
          }
        },
        {
          "name": "1.3 Get JiraConfig",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Config retrieved', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Token is masked', function() {",
                  "    pm.expect(jsonData.apiTokenMasked).to.include('****');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/jira/config/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jira", "config", "{{projectId}}"]
            },
            "description": "Get JiraConfig (API token is masked)"
          }
        },
        {
          "name": "1.4 Test Jira Connection",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Connection successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Connected is true', function() {",
                  "    pm.expect(jsonData.connected).to.be.true;",
                  "});",
                  "",
                  "pm.test('Shows user email', function() {",
                  "    pm.expect(jsonData.userEmail).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/jira/config/{{projectId}}/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jira", "config", "{{projectId}}", "test"]
            },
            "description": "Test Jira connection with Admin's email"
          }
        },
        {
          "name": "1.5 Admin Fetch Jira Issues",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Fetch successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Has issues array', function() {",
                  "    pm.expect(jsonData.issues).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Issues count > 0', function() {",
                  "    pm.expect(jsonData.issues.length).to.be.above(0);",
                  "    console.log('Fetched ' + jsonData.issues.length + ' issues');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/jira/fetch/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jira", "fetch", "{{projectId}}"]
            },
            "description": "Admin fetches Jira issues"
          }
        }
      ]
    },
    {
      "name": "Scene 2: Student Access",
      "item": [
        {
          "name": "2.1 Student Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('studentToken', jsonData.token);",
                  "    console.log('Student token saved!');",
                  "}",
                  "",
                  "pm.test('Login successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student1@fpt.edu.vn\",\n  \"password\": \"Student123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login as Student (must be invited to Jira workspace)"
          }
        },
        {
          "name": "2.2 Student Fetch Jira Issues",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Fetch successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.issues) {",
                  "    pm.test('Has issues', function() {",
                  "        pm.expect(jsonData.issues.length).to.be.above(0);",
                  "    });",
                  "    console.log('Student fetched ' + jsonData.issues.length + ' issues');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/jira/fetch/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jira", "fetch", "{{projectId}}"]
            },
            "description": "Student fetches Jira issues (email auto-filled from JWT)"
          }
        },
        {
          "name": "2.3 Student View Config",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Config retrieved', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Token is masked (Student cannot see real token)', function() {",
                  "    pm.expect(jsonData.apiTokenMasked).to.include('****');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/jira/config/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jira", "config", "{{projectId}}"]
            },
            "description": "Student views config (token masked for security)"
          }
        }
      ]
    },
    {
      "name": "Scene 3: Error Cases",
      "item": [
        {
          "name": "3.1 Fetch without Auth",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 Unauthorized', function() {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/jira/fetch/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jira", "fetch", "{{projectId}}"]
            },
            "description": "Attempt to fetch without JWT token"
          }
        },
        {
          "name": "3.2 Fetch Non-existent Project",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 404 Not Found', function() {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Has error message', function() {",
                  "    pm.expect(jsonData.error).to.include('No active Jira configuration');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/jira/fetch/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jira", "fetch", "00000000-0000-0000-0000-000000000000"]
            },
            "description": "Attempt to fetch from non-existent project"
          }
        },
        {
          "name": "3.3 Create Duplicate Config",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 400 Bad Request', function() {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Has duplicate error', function() {",
                  "    pm.expect(jsonData.error).to.include('already exists');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"jiraUrl\": \"https://beu2901.atlassian.net\",\n  \"apiToken\": \"fake-token\",\n  \"projectKey\": \"SP\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jira/config",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jira", "config"]
            },
            "description": "Attempt to create duplicate JiraConfig"
          }
        }
      ]
    },
    {
      "name": "Scene 4: Admin Management",
      "item": [
        {
          "name": "4.1 Update JiraConfig",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Update successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Has success message', function() {",
                  "    pm.expect(jsonData.message).to.include('updated');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectKey\": \"SP\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jira/config/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jira", "config", "{{projectId}}"]
            },
            "description": "Admin updates JiraConfig"
          }
        },
        {
          "name": "4.2 Get Setup Guide",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Guide retrieved', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Has setup steps', function() {",
                  "    pm.expect(jsonData.steps).to.be.an('array');",
                  "    pm.expect(jsonData.steps.length).to.equal(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/jira/setup-guide",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jira", "setup-guide"]
            },
            "description": "Get Jira setup guide"
          }
        },
        {
          "name": "4.3 Delete JiraConfig (Optional)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Delete successful', function() {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/jira/config/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jira", "config", "{{projectId}}"]
            },
            "description": "Admin deletes JiraConfig (use with caution!)"
          }
        }
      ]
    }
  ]
}
